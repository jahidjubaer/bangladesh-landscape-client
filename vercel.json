{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://bangladesh-landscape-api.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://bangladesh-landscape-api.onrender.com/uploads/:path*" },
    { "source": "/sitemap.xml", "destination": "https://bangladesh-landscape-api.onrender.com/sitemap.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
